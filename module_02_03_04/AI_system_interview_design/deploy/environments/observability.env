# The observability stack, as deploy/stack.sh reads it.
#
#   deploy/stack.sh observability      # make deploy-observability
#
# One stack for both environments: dev and prod both send to it, and their
# telemetry is told apart by deployment.environment.name.
STACK_NAME=loopboard-observability

# The same VPC and subnet as the app instances, so OTLP never leaves the VPC.
VpcId=vpc-01504f08e879526be
SubnetId=subnet-0549eee4300aabcb5
CloudFrontOriginPrefixListId=pl-b6a144df

# The app stacks' security groups (logical id SecurityGroup), the only senders
# the Collector accepts. A recreated app stack has a new one; update it here.
DevAppSecurityGroupId=sg-0e43a8a3251fdad77
ProdAppSecurityGroupId=sg-00bdc546ae6012c8d

InstanceType=t3.small
# Empty for the first deploy only; then pinned to the running instance's
# image, as in dev.env and prod.env (deploy/README.md, "Pin the AMI").
AmiId=
