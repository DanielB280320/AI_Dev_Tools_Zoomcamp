# The prod environment, as deploy/stack.sh reads it.
#
#   deploy/stack.sh prod       # the app stack
#   deploy/stack.sh prod ci    # its GitHub deploy user
#
# A second, independent copy of dev: its own instance, its own Postgres volume
# and its own address. Nothing is shared with dev but the template and the
# repository the instance builds from.
STACK_NAME=loopboard-prod

# The same VPC and subnet as dev. Separate compute and separate data is what
# isolates the two; a separate network would add a second NAT-less public
# subnet to maintain and isolate nothing that matters here.
VpcId=vpc-01504f08e879526be
SubnetId=subnet-0549eee4300aabcb5

InstanceType=t3.small

# Its own CloudFront distribution, so prod gets its own *.cloudfront.net URL
# and the instance is reachable only from CloudFront's edge.
EnableCloudFront=true
CloudFrontOriginPrefixListId=pl-b6a144df

# Never on prod: the seeded interviewers share the password printed in the
# README. POST /auth/register makes a real account.
SeedDemoData=false
