# The dev environment, as deploy/stack.sh reads it.
#
#   deploy/stack.sh dev        # the app stack
#   deploy/stack.sh dev ci     # its GitHub deploy user
#
# This is the original deployment. The stack keeps its original name because
# CloudFormation cannot rename a stack, and recreating it would hand out a new
# *.cloudfront.net domain — but that domain is the published dev URL
# (https://d1u9mpb2rc8ljk.cloudfront.net/), so the stack stays exactly where it
# is and only its role changed.
STACK_NAME=loopboard

# Filled in from the live stack — see deploy/README.md, "Environments".
VpcId=vpc-01504f08e879526be
SubnetId=subnet-0549eee4300aabcb5

InstanceType=t3.small
# The AMI the running instance was launched from. Without it, a stack update
# after AWS publishes a newer Amazon Linux image replaces the instance and
# wipes its Postgres volume (deploy/README.md, "Pin the AMI").
AmiId=ami-08be4b1b8afa29958

# HTTPS on a *.cloudfront.net name, with the instance reachable only from
# CloudFront's edge.
EnableCloudFront=true
CloudFrontOriginPrefixListId=pl-b6a144df

# Demo interviewers, who share one published password. Fine on dev.
SeedDemoData=true
